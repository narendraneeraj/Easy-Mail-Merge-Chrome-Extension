{
  "manifest_version": 3,
  "name": "Easy Mail Merge - Gmail Mail Merge",
  "version": "1.0.0",
  "description": "Personalized Gmail mail merge using CSV and Excel contacts.",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://gmail.googleapis.com/*"],
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.send"]
  },
  "action": {"default_title": "Easy Mail Merge"},
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
